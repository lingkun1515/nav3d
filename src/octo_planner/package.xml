<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>octo_planner</name>
  <version>0.1.0</version>
  <description>3D OctoMap global path planner for quadruped robot navigation</description>
  <maintainer email="juchunyu@qq.com">juchunyu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>octomap_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>

  <build_depend>liboctomap-dev</build_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>liboctomap1.9</exec_depend>
  <exec_depend>libpcl-all</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
