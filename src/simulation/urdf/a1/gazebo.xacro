<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="publish_odom" default="true"/>
    <xacro:arg name="publish_tf" default="true"/>

    <!-- A1 RL Controller Plugin: handles 12-DOF locomotion + odom + joint_states + TF -->
    <gazebo>
        <plugin name="a1_rl_controller" filename="libA1RLController.so">
            <robotNamespace>/</robotNamespace>

            <!-- 12 joints (FR, FL, RR, RL × hip, thigh, calf) -->
            <jointName>FR_hip_joint</jointName>
            <jointName>FR_thigh_joint</jointName>
            <jointName>FR_calf_joint</jointName>
            <jointName>FL_hip_joint</jointName>
            <jointName>FL_thigh_joint</jointName>
            <jointName>FL_calf_joint</jointName>
            <jointName>RR_hip_joint</jointName>
            <jointName>RR_thigh_joint</jointName>
            <jointName>RR_calf_joint</jointName>
            <jointName>RL_hip_joint</jointName>
            <jointName>RL_thigh_joint</jointName>
            <jointName>RL_calf_joint</jointName>

            <!-- ONNX model path -->
            <modelPath>package://simulation/models/policy_act_inference_stair.onnx</modelPath>

            <!-- ROS 2 topic names -->
            <cmdVelTopic>/cmd_vel</cmdVelTopic>
            <odomTopic>/odom</odomTopic>
            <jointStateTopic>/joint_states</jointStateTopic>

            <!-- cmd_vel timeout: zero velocity if no message received (default 0.5s) -->
            <cmdVelTimeout>0.5</cmdVelTimeout>

            <!-- TF frames (base_link = root, matches real robot) -->
            <odomFrameId>odom</odomFrameId>
            <robotBaseFrame>base_link</robotBaseFrame>

            <!-- When slam_mode, set these false so SLAM provides odom + TF -->
            <publish_odom>$(arg publish_odom)</publish_odom>
            <publish_tf>$(arg publish_tf)</publish_tf>
        </plugin>
    </gazebo>

    <!-- IMU attached directly to trunk, publishes in livox_frame (matches real robot).
         Position: co-located with LiDAR at x=+0.15 front, z=+0.13 above base_link,
         pitch=-15° down.  SLAM extrinsic lidar→imu is trivial (~5 cm); ignored in sim. -->
    <gazebo reference="trunk">
        <sensor type="imu" name="trunk_imu">
            <pose>0.10 0 0.08 0 0.261799 0</pose>
            <always_on>true</always_on>
            <update_rate>1000</update_rate>
            <visualize>false</visualize>
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.001</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.001</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.001</stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.01</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.01</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.01</stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
            <plugin name="trunk_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <remapping>~/out:=livox/imu</remapping>
                </ros>
                <initial_orientation_as_reference>false</initial_orientation_as_reference>
                <frame_name>livox_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- 3D LiDAR attached to trunk (x=+0.15 front, z=+0.13 above, pitch=-15° down).
         Matches real-robot livox_frame → base_link static TF in slam.launch.py. -->
    <gazebo reference="trunk">
        <sensor type="gpu_ray" name="lidar_3d">
            <pose>0.10 0 0.08 0 0.261799 0</pose>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>28</samples>
                        <min_angle>-0.122173</min_angle>
                        <max_angle>0.907571</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>30.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <plugin name="lidar_3d_plugin" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=livox/lidar</remapping>
                </ros>
                <output_type>sensor_msgs/PointCloud2</output_type>
                <frame_name>livox_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Foot friction (matches 3d-navi: mu1=0.6, mu2=0.6) -->
    <gazebo reference="FR_foot">
        <mu1>0.6</mu1>
        <mu2>0.6</mu2>
    </gazebo>
    <gazebo reference="FL_foot">
        <mu1>0.6</mu1>
        <mu2>0.6</mu2>
    </gazebo>
    <gazebo reference="RR_foot">
        <mu1>0.6</mu1>
        <mu2>0.6</mu2>
    </gazebo>
    <gazebo reference="RL_foot">
        <mu1>0.6</mu1>
        <mu2>0.6</mu2>
    </gazebo>

</robot>
